# ───────────────────────────────────────────────────────────────────────────
# APAMS — environment template. Copy to .env.local and fill in your values.
# Never commit real values to git.
# ───────────────────────────────────────────────────────────────────────────

# Frontend configuration (browser-safe). The anon key is designed to be
# public — authorisation is enforced by Row Level Security, not key secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Server-side ONLY ─────────────────────────────────────────────────────
# Used exclusively by trusted server-side code (Edge Functions run with it
# automatically via the Supabase runtime). NEVER prefix it with VITE_ and
# NEVER reference it in frontend code.
# SUPABASE_SERVICE_ROLE_KEY=
